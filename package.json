{
  "name": "electrical-panel-dash",
  "private": true,
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc -b",
    "validate": "tsx scripts/validate.ts",
    "seed": "tsx scripts/seed.ts",
    "icons": "pwa-assets-generator",
    "og-image": "node scripts/og-image.mjs",
    "dmg-background": "node scripts/dmg-background.mjs",
    "seed:demo": "tsx scripts/make-smart-demo.ts && cross-env PANEL_PASSWORD=demo tsx scripts/seed.ts data/demo.yaml public/app/demo.panel && cross-env PANEL_PASSWORD=demo tsx scripts/seed.ts data/demo-smart.yaml public/app/demo-smart.panel",
    "dev:desktop": "cross-env VITE_TARGET=desktop vite --port 5181",
    "build:desktop": "cross-env VITE_TARGET=desktop vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "i18n:check": "node scripts/i18n-keys.mjs ru && node scripts/i18n-keys.mjs en && node scripts/i18n-keys.mjs sr && node scripts/i18n-keys.mjs es && node scripts/i18n-keys.mjs de"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@lucide/vue": "^1.51.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-http": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.5.0",
    "idb-keyval": "^6.3.0",
    "js-yaml": "^5.4.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
